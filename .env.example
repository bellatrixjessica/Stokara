# Salin file ini menjadi .env, lalu isi nilainya.
# File .env berisi rahasia dan TIDAK ikut di-upload ke GitHub.

# Kunci untuk mengamankan session login. Buat dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=isi-dengan-kunci-acak

# Alamat database MongoDB Atlas. Nama database di bagian akhir: /stokara
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/stokara?retryWrites=true&w=majority

# Password awal untuk akun contoh (dipakai script seed nanti)
DEMO_PASSWORD=isi-password-demo

# 1 = mode pengembangan (error tampil detail). Di Vercel jangan diisi.
FLASK_DEBUG=1
